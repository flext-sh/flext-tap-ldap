# ============================================================================
# JUNK FILES AND ANTI-PATTERNS - ZERO TOLERANCE
# ============================================================================

# Archive directories - Block all junk accumulation
archive/
archives/
temp_*/
temp/
tmp/
.tmp/
backup/
backups/
.bak/
old/
obsolete/
deprecated/

# AI-generated reports and analysis files - FORBIDDEN
*_REPORT.md
*_REPORT_*.md
*_ANALYSIS*.md
*_SUMMARY*.md
CONFIG_MIGRATION*.md
FLEXT_*_MIGRATION*.md
DEVELOPMENT_STANDARDS.md
FLEXT_*_PATTERNS.md
LOGGING_MIGRATION.md
STRICT_COMPLIANCE.md
LEVEL1_*.md
DUPLICATION_REPORT.md
DUPLICATE_CODE_*.md
LINT_CORRECTIONS_*.md

# Fix scripts and validation files - FORBIDDEN
fix_*.py
*_fix.py
*_validation.py
validate_*.py
investigate_*.py
debug_*.py
test_fix_*.py
migrate_*.py
*_migration.py

# Timestamped files and temporary analysis
*_20[0-9][0-9]*.py
*_20[0-9][0-9]*.md
*_20[0-9][0-9]*.json
*_backup_*
*_temp_*

